{
 "info": {
  "name": "Zyvencore base + auth + comercio",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Solo base local desechable. La carpeta 'Automated local' y 'Commerce local' no requieren Google, Mercado Pago, Azure ni correo reales. Habilitar el cookie jar. Nunca guardar datos de identidad reales ni secretos en el entorno."
 },
 "event": [
  {
   "listen": "prerequest",
   "script": {
    "type": "text/javascript",
    "exec": [
     "if (!pm.environment.get(\"email\")) { pm.environment.set(\"email\", \"postman-\" + Date.now() + \"@example.com\"); pm.environment.set(\"password\", \"pw-\" + String(Date.now()).slice(-7)); }",
     "if (!pm.environment.get(\"idempotencyKey\")) { pm.environment.set(\"idempotencyKey\", \"pm-\" + Date.now()); }"
    ]
   }
  }
 ],
