# Local template; never copy reference-project secrets.
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://zy_local:REPLACE_LOCAL_PASSWORD@127.0.0.1:5432/zyvalentine
POSTGRES_PASSWORD=REPLACE_LOCAL_PASSWORD
# Generate with python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
CORS_ORIGINS=["http://localhost:5173"]
DB_SSL_MODE=disable
# DB_SSL_CA_FILE=/path/to/trusted-ca.pem
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=10
DB_CONNECTION_BUDGET=20
DB_RESERVED_CONNECTIONS=2
WEB_CONCURRENCY=1
APP_REPLICAS=1
SESSION_MINUTES=30
COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW=60
# Optional locally; endpoint returns GOOGLE_NOT_CONFIGURED until set.
GOOGLE_CLIENT_ID=
# For develop/staging/production: verified TLS + HTTPS CORS + Secure cookies.
# Encode reserved URL characters in DATABASE_URL password; use URL-safe local password in Compose.
