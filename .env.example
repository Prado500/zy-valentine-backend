# Plantilla local. Nunca copiar secretos reales de Azure, del proyecto de
# referencia ni de docs/AZURECONF.md a este archivo (.env está en .gitignore).
# Generar secretos con: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Entorno -----------------------------------------------------------------
APP_ENV=local
PORT=8000

# --- Base de datos -----------------------------------------------------------
# En Azure la cadena puede venir con ?sslmode=require o ?ssl=require: la app
# acepta solo esos dos parámetros y los traduce a DB_SSL_MODE=verify-full.
# Cualquier otro parámetro, o pedir TLS desactivado fuera de local, aborta el arranque.
DATABASE_URL=postgresql+asyncpg://zy_local:REPLACE_LOCAL_PASSWORD@127.0.0.1:5432/zyvalentine
POSTGRES_PASSWORD=REPLACE_LOCAL_PASSWORD
DB_SSL_MODE=disable
# DB_SSL_CA_FILE=/ruta/a/ca-confiable.pem
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=10
DB_CONNECTION_BUDGET=20
DB_RESERVED_CONNECTIONS=2
WEB_CONCURRENCY=1
APP_REPLICAS=1

# --- Sesión (NO se usa JWT: sesión opaca revocable en cookie HttpOnly) --------
SESSION_SECRET=
SESSION_MINUTES=30
CSRF_SECONDS=3600
# `none` cuando el frontend y el backend viven en dominios distintos (SWA + App
# Service); exige cookies seguras, es decir, APP_ENV distinto de local.
COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW=60

# --- Frontend y CORS ---------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# --- Google (opcional en local; sin él /auth/google responde 503) -------------
GOOGLE_CLIENT_ID=

# --- Datos personales --------------------------------------------------------
# Clave dedicada del HMAC de cédula. Si se deja vacía deriva de SESSION_SECRET;
# rotarla invalida la comprobación de documentos ya guardados.
PII_HMAC_KEY=

# --- Pagos (Mercado Pago) ----------------------------------------------------
# none = sin proveedor: /verify y el webhook responden 503 explícito.
# fake = proveedor de laboratorio: aprueba cualquier pago SIN cobrar, para recorrer
#        el flujo completo en local. La aplicación NO arranca con fake si APP_ENV
#        no es 'local'.
PAYMENT_PROVIDER=none
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PURCHASE_AMOUNT_CENTS=0
PURCHASE_CURRENCY=COP
PURCHASE_PENDING_MINUTES=60

# --- Almacenamiento de fotos -------------------------------------------------
# local solo en APP_ENV=local; develop/staging/production exigen azure.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.local-storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=
# Contenedor efímero del eager upload. Si se deja vacío, el permanente hace de los
# dos bajo el prefijo `temporal/`. Con STORAGE_BACKEND=local se usa la carpeta
# <LOCAL_STORAGE_DIR>/_temporal y no hace falta ninguna credencial.
AZURE_TEMPORAL_CONTAINER_NAME=
MAX_PHOTO_BYTES=3000000
MAX_PHOTOS_PER_LETTER=6
# Tope del documento HTML adjunto al correo, ya en Base64 (los proveedores cortan en
# 25 MB). Las fotos que no caben se omiten con un aviso dentro del propio documento.
MAX_LETTER_DOCUMENT_BYTES=24000000

# --- Correo ------------------------------------------------------------------
# console no envía nada (desarrollo y pruebas); smtp exige usuario y contraseña.
MAIL_BACKEND=console
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TIMEOUT=10

# --- Cola de cartas (Azure Service Bus) --------------------------------------
# TODO OPCIONAL. Si falta cualquiera de las dos primeras variables, la API arranca
# igual y escribe la carta de forma síncrona (degradación elegante); el worker
# informa y termina sin error. Con ambas definidas, POST /api/v1/letters responde
# 202 y worker.py hace el INSERT en lotes.
AZURE_SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_QUEUE_NAME=
# Mensajes por lote. 12 es el tope acordado para los 240 IOPS del disco de la B1ms.
SERVICE_BUS_MAX_BATCH=12
SERVICE_BUS_MAX_WAIT=5
SERVICE_BUS_MAX_ATTEMPTS=5
# Pool dedicado del worker: 5 conexiones de las 20; las otras 15 son de la API.
WORKER_DB_POOL_SIZE=5
WORKER_DB_POOL_TIMEOUT=20
WORKER_IDLE_BACKOFF=5

# --- Reglas de negocio -------------------------------------------------------
# El contenido se congela al publicar la carta (decisión documentada).
FREEZE_LETTER_AFTER_PUBLISH=true

# --- Variables heredadas que esta API NO usa ---------------------------------
# JWT_SECRET_KEY, ALGORITHM y ACCESS_TOKEN_EXPIRE_MINUTES existen en Azure por el
# proyecto de referencia. Aquí se ignoran: la autenticación es por sesión opaca.
